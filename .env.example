# Copy to .env (never commit .env). Everything here is optional; defaults run the mock model on localhost.


# --- server (loopback only by default) ---
BOUGH_HOST=127.0.0.1
BOUGH_PORT=8000


# --- auth + storage ---
# off      = single local user, no login (only safe on loopback)
# supabase = email+password sign-in through your Supabase project; every /api and /ws call needs a token
BOUGH_AUTH_MODE=off
BOUGH_SUPABASE_URL=https://<project-ref>.supabase.co
BOUGH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...      # public key; safe to ship to the browser
# sqlite   = local file (BOUGH_DB_PATH); rows are still scoped per user when auth is on
# supabase = Postgres via PostgREST using each user's own JWT + RLS (requires BOUGH_AUTH_MODE=supabase).
#            Apply supabase/migrations/*.sql to the project first.
BOUGH_MEMORY_BACKEND=sqlite
BOUGH_DB_PATH=data/bough.sqlite3
# Extra browser Origins allowed to talk to /api and /ws (comma-separated); loopback is always allowed.
BOUGH_ALLOWED_ORIGINS=


# --- model ---
# mock = deterministic offline model (default); http = any OpenAI-compatible chat/completions endpoint
BOUGH_MODEL_BACKEND=mock
# Example for Groq:
# BOUGH_MODEL_URL=https://api.groq.com/openai/v1/chat/completions
# BOUGH_MODEL_NAME=qwen/qwen3.8-27b
# BOUGH_MODEL_API_KEY=
# Example for a local Ollama server:
# BOUGH_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# BOUGH_MODEL_NAME=llama3.2
# BOUGH_MODEL_JSON_MODE=true
BOUGH_MODEL_TIMEOUT_S=20
# Web search for explicit requests ("use the web ...", "search online ...", "look it up online").
# auto = with Groq openai/gpt-oss-20b / gpt-oss-120b, turn on Groq's built-in browser_search for that reply;
# off = never search. Other models answer from their own knowledge.
BOUGH_MODEL_WEB_SEARCH=auto
# A browser search takes longer than a plain answer; this replaces BOUGH_MODEL_TIMEOUT_S for searched replies
BOUGH_MODEL_WEB_SEARCH_TIMEOUT_S=60
# Groq models without browser_search: this gpt-oss model searches, the main model answers. Empty = off.
BOUGH_MODEL_WEB_SEARCH_HELPER=openai/gpt-oss-20b
BOUGH_MODEL_WEB_SEARCH_HELPER_TOKENS=700
# --- GitHub lookups ("newest issue in github repo owner/repo") — read-only GET to api.github.com ---
BOUGH_GITHUB_LOOKUP=auto
# optional; raises the anonymous 60 requests/hour limit
BOUGH_GITHUB_TOKEN=
# Simulated delay for the mock model; handy for trying the Stop button / request replacement
BOUGH_MOCK_LATENCY_S=0


# --- text-to-speech (ElevenLabs; adds a "Listen" button to replies) ---
# Defaults fit the ElevenLabs FREE plan: 10,000 credits/month, personal non-commercial use, and attribution
# (the dashboard shows "Voice by ElevenLabs" while this is on). The key never reaches the browser.
# off = no audio (default); elevenlabs = ElevenLabs API; groq = Groq Orpheus (uses your Groq key, see below)
BOUGH_TTS_BACKEND=off
# Create a key at https://elevenlabs.io/app/settings/api-keys (Text to Speech permission is enough)
ELEVENLABS_API_KEY=
# Free plan: Voice Library (community) voices are blocked over the API (HTTP 402 paid_plan_required).
# Use a default voice, or one you designed/cloned under My Voices. Default voices retire on 2026-12-31.
BOUGH_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 costs 0.5 credit/char (~20,000 chars/month free); eleven_multilingual_v2 costs 1 credit/char
BOUGH_ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# mp3_44100_128 is the best format on free; 192 kbps MP3 and 44.1 kHz PCM/WAV are paid-only
BOUGH_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
BOUGH_ELEVENLABS_ALLOW_PAID_FORMATS=false
# Each reply is clipped to this many characters before sending (code blocks are skipped, not read)
BOUGH_TTS_MAX_CHARS=1000
BOUGH_TTS_TIMEOUT_S=30


# --- Groq speech: Orpheus voice (BOUGH_TTS_BACKEND=groq) and Whisper mic input (BOUGH_STT_BACKEND=groq) ---
# Key: GROQ_API_KEY, or leave it empty to reuse BOUGH_MODEL_API_KEY when BOUGH_MODEL_URL is api.groq.com.
GROQ_API_KEY=
# Orpheus is English-only, WAV-only, 200 characters per request (Bough splits longer replies and joins the audio).
# Accept the model's terms once in the Groq console Playground, or Groq answers HTTP 400.
BOUGH_GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel, troy
BOUGH_GROQ_TTS_VOICE=autumn
# off = no mic button (default); groq = "Speak" button -> Groq Whisper -> message; reply is read aloud if TTS is on
BOUGH_STT_BACKEND=off
# whisper-large-v3-turbo = cheapest/fastest; whisper-large-v3 = most accurate. Groq bills at least 10 s per clip.
BOUGH_GROQ_STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 language hint (empty = auto-detect)
BOUGH_STT_LANGUAGE=en
# Upload cap in bytes (Groq free tier: 25 MB)
BOUGH_STT_MAX_BYTES=25000000


# --- per-request limits ---
BOUGH_MAX_MODEL_CALLS=3
BOUGH_CYCLE_TIMEOUT_S=60
BOUGH_MAX_PROPOSALS=4
BOUGH_WORKSPACE_MAX_ITEMS=40
BOUGH_MAX_RETRIEVED_MEMORIES=5
BOUGH_MAX_RETRIES=1
BOUGH_MAX_INPUT_CHARS=12000
# Completion-token caps per model task. Code answers need room; 256 (the old value) truncated them.
BOUGH_MODEL_PLAN_TOKENS=1500
BOUGH_MODEL_REVIEW_TOKENS=600
BOUGH_MODEL_REPLY_TOKENS=6000
BOUGH_MAX_REPLY_CHARS=16000


# --- optional behaviour ---
BOUGH_PIPELINE=root                      # root = model answers freely, agents filter it (Bough); proposals = council flow
BOUGH_ROOT_REPAIR=true                   # root pipeline: allow one model rewrite when branch checks fail
BOUGH_ENABLE_MODEL_REVIEW=false          # same-model self-review of proposals (+1 model call)
BOUGH_INCLUDE_MODEL_INTERPRETATIONS=false
# Built-in read-only knowledge seeds (backend/memory/seeds/*.json): coding + English conventions
BOUGH_SEED_ENABLED=true
BOUGH_MAX_SEED_MEMORIES=4
BOUGH_BIAS_STEP=0.03
BOUGH_BIAS_LIMIT=0.15


# --- web fetch (Rust CLI in tools/web_fetch; build with `cargo build --release`) ---
# Both paths must be absolute.
BOUGH_WEB_FETCH_ENABLED=false
BOUGH_WEB_FETCH_EXECUTABLE=/abs/path/to/bough/tools/web_fetch/target/release/web_fetch
BOUGH_WEB_FETCH_WRAPPER=/abs/path/to/bough/tools/web_fetch/web_fetch_wrapper.py
BOUGH_WEB_FETCH_ALLOWED_HOSTS=example.com
# Max characters of page text passed to the language model (CLI itself caps at 64 KiB)
BOUGH_WEB_FETCH_CONTEXT_CHARS=6000
