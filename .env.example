# Copy to .env (never commit .env). Everything here is optional; defaults run the mock model on localhost.


# --- server (loopback only by default) ---
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000


# --- auth + storage ---
# off      = single local user, no login (only safe on loopback)
# supabase = email+password sign-in through your Supabase project; every /api and /ws call needs a token
BRAIN_AUTH_MODE=off
BRAIN_SUPABASE_URL=https://<project-ref>.supabase.co
BRAIN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...      # public key; safe to ship to the browser
# sqlite   = local file (BRAIN_DB_PATH); rows are still scoped per user when auth is on
# supabase = Postgres via PostgREST using each user's own JWT + RLS (requires BRAIN_AUTH_MODE=supabase).
#            Apply supabase/migrations/*.sql to the project first.
BRAIN_MEMORY_BACKEND=sqlite
BRAIN_DB_PATH=data/brain.sqlite3
# Extra browser Origins allowed to talk to /api and /ws (comma-separated); loopback is always allowed.
BRAIN_ALLOWED_ORIGINS=


# --- model ---
# mock = deterministic offline model (default); http = any OpenAI-compatible chat/completions endpoint
BRAIN_MODEL_BACKEND=mock
# Example for Groq:
# BRAIN_MODEL_URL=https://api.groq.com/openai/v1/chat/completions
# BRAIN_MODEL_NAME=qwen/qwen3.8-27b
# BRAIN_MODEL_API_KEY=
# Example for a local Ollama server:
# BRAIN_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# BRAIN_MODEL_NAME=llama3.2
# BRAIN_MODEL_JSON_MODE=true
BRAIN_MODEL_TIMEOUT_S=20
# Simulated delay for the mock model; handy for trying the Stop button / request replacement
BRAIN_MOCK_LATENCY_S=0


# --- per-request limits ---
BRAIN_MAX_MODEL_CALLS=3
BRAIN_CYCLE_TIMEOUT_S=60
BRAIN_MAX_PROPOSALS=4
BRAIN_WORKSPACE_MAX_ITEMS=40
BRAIN_MAX_RETRIEVED_MEMORIES=5
BRAIN_MAX_RETRIES=1
BRAIN_MAX_INPUT_CHARS=12000
# Completion-token caps per model task. Code answers need room; 256 (the old value) truncated them.
BRAIN_MODEL_PLAN_TOKENS=1500
BRAIN_MODEL_REVIEW_TOKENS=600
BRAIN_MODEL_REPLY_TOKENS=6000
BRAIN_MAX_REPLY_CHARS=16000


# --- optional behaviour ---
BRAIN_ENABLE_MODEL_REVIEW=false          # same-model self-review of proposals (+1 model call)
BRAIN_INCLUDE_MODEL_INTERPRETATIONS=false
# Built-in read-only knowledge seeds (backend/memory/seeds/*.json): coding + English conventions
BRAIN_SEED_ENABLED=true
BRAIN_MAX_SEED_MEMORIES=4
BRAIN_BIAS_STEP=0.03
BRAIN_BIAS_LIMIT=0.15


# --- web fetch (Rust CLI in tools/web_fetch; build with `cargo build --release`) ---
# Both paths must be absolute.
BRAIN_WEB_FETCH_ENABLED=false
BRAIN_WEB_FETCH_EXECUTABLE=/abs/path/to/brain_ai/tools/web_fetch/target/release/web_fetch
BRAIN_WEB_FETCH_WRAPPER=/abs/path/to/brain_ai/tools/web_fetch/web_fetch_wrapper.py
BRAIN_WEB_FETCH_ALLOWED_HOSTS=example.com
# Max characters of page text passed to the language model (CLI itself caps at 64 KiB)
BRAIN_WEB_FETCH_CONTEXT_CHARS=6000
